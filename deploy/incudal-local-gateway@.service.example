[Unit]
Description=Configure PayIncus controller gateway %i
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
Group=incudal
WorkingDirectory=/opt/incudal
EnvironmentFile=/opt/incudal/.env
ExecStart=/usr/local/libexec/incudal/incudal-online-task local-gateway %i
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
