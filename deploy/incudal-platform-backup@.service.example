[Unit]
Description=PayIncus platform backup or recovery %i
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
Group=incudal
WorkingDirectory=/opt/incudal
EnvironmentFile=/opt/incudal/.env
Environment=NODE_ENV=production
UMask=0027
ExecStart=/usr/local/libexec/incudal/incudal-online-task platform-backup %i
TimeoutStartSec=4h
KillMode=control-group
StandardOutput=journal
StandardError=journal
